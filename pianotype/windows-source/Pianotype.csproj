<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup>
  <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
  <UseWindowsForms>true</UseWindowsForms><ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode><EnableWindowsTargeting>true</EnableWindowsTargeting>
  <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
  <AssemblyName>Pianotype</AssemblyName><Version>1.2.1</Version>
  <ApplicationIcon>Assets/Pianotype.ico</ApplicationIcon>
  <PublishSingleFile>true</PublishSingleFile><SelfContained>true</SelfContained>
  <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  <DebugType>none</DebugType>
 </PropertyGroup>
 <ItemGroup><PackageReference Include="NAudio" Version="2.2.1" /></ItemGroup>
 <ItemGroup><EmbeddedResource Include="Assets/**/*" Exclude="Assets/*.mp3" /><Compile Remove="Tests/**/*.cs" /></ItemGroup>
</Project>
